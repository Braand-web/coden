# AI provider credentials are backend/Railway only.
# Never expose provider credentials through VITE_*, generated frontend code,
# browser URLs, logs, or chat messages.

# Canonical public URL used for links, OAuth callbacks and provider metadata.
APP_URL="https://coden.fun"
CODEN_PUBLIC_APP_URL="https://coden.fun"

# OpenRouter Configuration
# Recommended Railway variable name: OPENROUTER_API_KEY.
# Accepted aliases: OPEN_ROUTER_API_KEY, OPENROUTER_KEY, OPENROUTER_TOKEN.
OPENROUTER_API_KEY=""
OPENROUTER_SITE_URL="https://coden.fun"
OPENROUTER_APP_NAME="Coden"

# AI Policy Configuration
AI_ALLOWED_MODELS="openai/gpt-5.6-luna,google/gemini-3.7-flash,deepseek/deepseek-v4-pro-0813,qwen/qwen3.8-27b,openai/gpt-5.6-terra,z-ai/glm-5.3,anthropic/claude-sonnet-5,x-ai/grok-4.6,openai/gpt-5.6-sol,anthropic/claude-opus-5,anthropic/claude-fable-5"
AI_STRICT_MODEL_ALLOWLIST=true
AI_DISABLE_UNLISTED_FALLBACKS=true

# Supabase Configuration
SUPABASE_URL="https://ftmbiocvslxctldfihcp.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
VITE_SUPABASE_URL="https://ftmbiocvslxctldfihcp.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Coden billing — Saspay checkout for the FlowPay account.
# These secrets are backend/Railway only and must never use a VITE_* prefix.
SASPAY_API_URL="https://api.saspay.me/api/v1"
SASPAY_API_KEY=""
SASPAY_WEBHOOK_SECRET=""
SASPAY_COUNTRY="CM"
# Internal accounting conversion used to preserve the USD COGS model.
SASPAY_XAF_PER_USD="600"

# Platform Admin
# Comma-separated list. Never store admin passwords in code or env files.
CODEN_ADMIN_EMAILS="novacore629@gmail.com"

# Supabase Google Auth setup
# Enable Google in Supabase Auth Providers and add the Google OAuth Client ID/Secret there.
# Add these Supabase Auth Redirect URLs:
# - https://www.coden.fun/auth.html
# - https://www.coden.fun/auth.html?redirect=/dashboard.html
# - http://localhost:3000/auth.html
# Google Cloud Authorized JavaScript origins should include:
# - https://www.coden.fun
# - http://localhost:3000
# Google Cloud Authorized redirect URI must be the Supabase callback, for example:
# - https://<project-ref>.supabase.co/auth/v1/callback

# Auto-provisioning of dedicated Supabase project per generated app
# (DB + Auth + Storage via Supabase Management API).
CODEN_SUPABASE_MGMT_TOKEN=sbp_xxx
CODEN_SUPABASE_ORG_ID=
CODEN_SUPABASE_REGION=eu-west-2

# Generated app publication — Vercel is the only active publisher.
# The token belongs on Railway/server only and must never be exposed to Vite or
# generated frontend code.
VERCEL_TOKEN=""
VERCEL_TEAM_ID=""
VERCEL_TEAM_SLUG=""
VERCEL_ROOT_DOMAIN="coden.fun"
# Configure this root domain in Vercel (wildcard or per-project domains). Coden
# only reports publication success after the generated app is reachable on its
# verified Coden subdomain; it never exposes a project.vercel.app URL as the
# public project URL.
CODEN_ROOT_DOMAIN="coden.fun"
CODEN_DEPLOY_TIMEOUT_MS="300000"

# Security boundaries for untrusted generated code. Keep both unset/disabled
# on the main SaaS process until a separate container or VM worker is wired.
# Production refuses server-side preview/build execution without this boundary.
CODEN_BUILD_RUNNER_ISOLATION=""
CODEN_SANDBOX_ISOLATION=""
CODEN_ANALYTICS_SIGNING_SECRET=""

# Preview verification. The browser audit is what proves a generated app
# actually renders and reacts, and only a verified preview unlocks publishing,
# so it is on by default. Turning it off leaves every project unpublishable.
AGENT_BROWSER_RUNNER_ENABLED="1"
# Point Playwright at a Chromium the image already ships (Nix-based images do
# not carry the build Playwright pins). Leave empty to use Playwright's own.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=""

# Coden Universal Agent OS rollout. These are backend feature gates; never
# expose them through VITE_* variables. Set a value to 0 to disable it safely.
CODEN_CONVERSATION_UI_V2=1
CODEN_REAL_ACTIVITY_SHIMMER=1
CODEN_RESPONSE_STREAM_V2=1
CODEN_ADVANCED_MODES=1
CODEN_UNIVERSAL_MANIFEST=1
CODEN_PREVIEW_ADAPTERS=1
CODEN_FULLSTACK_PREVIEW=1
CODEN_ROUTER_V2=1
CODEN_DAG_RUNTIME=1
CODEN_PARALLEL_WRITERS=1
CODEN_USER_STEERING=1
CODEN_DEPLOYMENT_ADAPTERS=1
CODEN_INDEPENDENT_REVIEW=1

# Optional additional beta accounts allowed to self-activate server-owned test
# credits. Store comma-separated SHA-256 hashes of normalized email addresses.
CODEN_UNLIMITED_TEST_EMAIL_HASHES=""

# Temporary, IP-gated generation access for a controlled beta test. Keep this
# disabled by default. All four values are required and the access expires
# automatically at CODEN_TEMPORARY_GENERATION_EXPIRES_AT.
CODEN_TEMPORARY_GENERATION_ACCESS="0"
CODEN_TEMPORARY_GENERATION_IPS=""
CODEN_TEMPORARY_GENERATION_EMAIL=""
CODEN_TEMPORARY_GENERATION_EXPIRES_AT=""
# Set to 1 only when the hosting proxy supplies a trusted X-Forwarded-For
# header. Keep 0 for direct local testing.
CODEN_TEMPORARY_GENERATION_TRUST_PROXY="0"
CODEN_TEMPORARY_GENERATION_UNLIMITED_CREDITS="0"
